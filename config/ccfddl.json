{
  "enabled": true,
  "source": "https://ccfddl.com/conference/initial.json",
  "cacheFile": "../data/arxiv-digest/ccfddl-cache.json",
  "lookaheadDays": 180,
  "maxItems": 10,
  "timezone": "Asia/Shanghai",
  "chunkSize": 4,
  "includeRanks": [
    "A",
    "B",
    "C"
  ],
  "includeUnrankedForCoreFields": true,
  "preferFieldPriority": true,
  "excludeTitles": [
    "NOSSDAV",
    "MLSys",
    "BlockSys",
    "WoWMoM"
  ],
  "fields": [
    {
      "label": "音频/语音",
      "priority": 12,
      "terms": [
        "acoustics",
        "speech",
        "spoken language",
        "audio",
        "voice",
        "sound"
      ]
    },
    {
      "label": "音乐",
      "priority": 12,
      "terms": [
        "music",
        "ismir",
        "sound",
        "song",
        "singing"
      ]
    },
    {
      "label": "信号处理",
      "priority": 10,
      "terms": [
        "signal processing",
        "signal and information processing"
      ]
    },
    {
      "label": "多媒体",
      "priority": 11,
      "terms": [
        "multimedia",
        "multi-modal",
        "multimodal"
      ]
    },
    {
      "label": "机器学习",
      "priority": 6,
      "terms": [
        "machine learning",
        "neural information processing",
        "learning representations",
        "artificial intelligence",
        "learning theory"
      ]
    },
    {
      "label": "计算机视觉",
      "priority": 4,
      "terms": [
        "computer vision",
        "pattern recognition",
        "image processing"
      ]
    },
    {
      "label": "自然语言处理",
      "priority": 4,
      "terms": [
        "computational linguistics",
        "natural language",
        "language processing"
      ]
    },
    {
      "label": "数据挖掘/检索",
      "priority": 3,
      "terms": [
        "data mining",
        "information retrieval",
        "knowledge discovery",
        "web search"
      ]
    }
  ]
}
