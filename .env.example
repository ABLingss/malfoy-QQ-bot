# Copy to .env and fill in. Never commit .env.
# 推荐直接运行 scripts/setup-secrets.sh，避免密钥出现在 shell 历史或聊天记录中。
OPENCODE_API_KEY=oc_sk-your-opencode-go-api-key
OPENCODE_BASE_URL=https://opencode.ai/inference/go/v1
OPENCODE_MODEL=deepseek-v4.1-flash
OPENCODE_SESSION=qq-bot
# DeepSeek 官方 Key 仅用于 /tools/search 与 /tools/fetch
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
QQ_BOT_UIN=123456789
# setup-secrets.sh 会在缺失或为占位值时自动生成
ONEBOT_TOKEN=replace-with-random-token

GITHUB_MIRROR=https://ghproxy.com/https://github.com
GITHUB_CONTENT_MIRROR=https://ghproxy.com/https://raw.githubusercontent.com
GRAVATAR_MIRROR=https://cravatar.cn
